<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <RadioGroup
            android:id="@+id/inputTypeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/radioDays"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Berechnung über Anzahl der Tage" />

            <RadioButton
                android:id="@+id/radioDateRange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Berechnung über Anfangsdatum und Enddatum" />
        </RadioGroup>

        <EditText
            android:id="@+id/inputDays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Anzahl Tage"
            android:inputType="numberSigned" />

        <EditText
            android:id="@+id/inputStartDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Anfangsdatum (dd.MM.yyyy)"
            android:inputType="text" />

        <EditText
            android:id="@+id/inputEndDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Enddatum (dd.MM.yyyy)"
            android:inputType="text" />

        <EditText
            android:id="@+id/inputMoney"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Geldbetrag/Schulden"
            android:inputType="numberDecimal|numberSigned" />

        <EditText
            android:id="@+id/inputZins"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Zinssatz in Prozent"
            android:inputType="numberDecimal|numberSigned" />

        <Spinner
            android:id="@+id/inputMethod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/labelOrderName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Auftragsname"
            android:visibility="gone" />

        <EditText
            android:id="@+id/inputOrderName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Auftragsname"
            android:visibility="gone" />

        <TextView
            android:id="@+id/labelOrderDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Auftragsdatum (dd.MM.yyyy)"
            android:visibility="gone" />

        <EditText
            android:id="@+id/inputOrderDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="dd.MM.yyyy"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Berechnen" />

    </LinearLayout>
</ScrollView>
